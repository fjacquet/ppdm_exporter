{
  "title": "PowerProtect — Backup History (global search)",
  "uid": "ppdm-backup-history",
  "tags": ["ppdm", "backup", "history"],
  "schemaVersion": 39, "version": 2, "time": {"from": "now-30d", "to": "now"},
  "templating": {"list": [
    {"name": "tenant", "type": "query", "datasource": {"type": "postgres", "uid": "backuphistory"},
     "query": "SELECT DISTINCT tenant FROM backup_jobs ORDER BY 1", "includeAll": true, "multi": true,
     "current": {"text": "All", "value": "$__all"}},
    {"name": "server", "type": "query", "datasource": {"type": "postgres", "uid": "backuphistory"},
     "query": "SELECT DISTINCT server FROM backup_jobs ORDER BY 1", "includeAll": true, "multi": true,
     "current": {"text": "All", "value": "$__all"}},
    {"name": "result_status", "type": "query", "datasource": {"type": "postgres", "uid": "backuphistory"},
     "query": "SELECT DISTINCT result_status FROM backup_jobs ORDER BY 1", "includeAll": true, "multi": true,
     "current": {"text": "All", "value": "$__all"}}
  ]},
  "panels": [
    {"id": 10, "type": "stat", "title": "Jobs in range", "datasource": {"type": "postgres", "uid": "backuphistory"},
     "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
     "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "value"},
       "thresholds": {"mode": "absolute", "steps": [
         {"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 1}]}},
       "overrides": []},
     "options": {"colorMode": "value", "graphMode": "none", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
     "targets": [{"refId": "A", "format": "table", "rawQuery": true,
       "rawSql": "SELECT COUNT(*) AS value FROM backup_jobs WHERE $__timeFilter(created_at) AND tenant IN ($tenant) AND server IN ($server) AND result_status IN ($result_status)"}]},
    {"id": 11, "type": "stat", "title": "Failed jobs", "datasource": {"type": "postgres", "uid": "backuphistory"},
     "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
     "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "value"},
       "thresholds": {"mode": "absolute", "steps": [
         {"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 1}]}},
       "overrides": []},
     "options": {"colorMode": "value", "graphMode": "none", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
     "targets": [{"refId": "A", "format": "table", "rawQuery": true,
       "rawSql": "SELECT COUNT(*) AS value FROM backup_jobs WHERE $__timeFilter(created_at) AND result_status = 'FAILED' AND tenant IN ($tenant) AND server IN ($server) AND result_status IN ($result_status)"}]},
    {"id": 12, "type": "stat", "title": "Bytes transferred", "datasource": {"type": "postgres", "uid": "backuphistory"},
     "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
     "fieldConfig": {"defaults": {"unit": "bytes", "color": {"mode": "value"},
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}},
       "overrides": []},
     "options": {"colorMode": "value", "graphMode": "none", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
     "targets": [{"refId": "A", "format": "table", "rawQuery": true,
       "rawSql": "SELECT COALESCE(SUM(bytes_transferred), 0) AS value FROM backup_jobs WHERE $__timeFilter(created_at) AND tenant IN ($tenant) AND server IN ($server) AND result_status IN ($result_status)"}]},
    {"id": 13, "type": "stat", "title": "Distinct assets", "datasource": {"type": "postgres", "uid": "backuphistory"},
     "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
     "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "value"},
       "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}},
       "overrides": []},
     "options": {"colorMode": "value", "graphMode": "none", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
     "targets": [{"refId": "A", "format": "table", "rawQuery": true,
       "rawSql": "SELECT COUNT(DISTINCT asset_name) AS value FROM backup_jobs WHERE $__timeFilter(created_at) AND tenant IN ($tenant) AND server IN ($server) AND result_status IN ($result_status)"}]},
    {"id": 1, "type": "table", "title": "Backup jobs", "datasource": {"type": "postgres", "uid": "backuphistory"},
     "gridPos": {"h": 12, "w": 24, "x": 0, "y": 4},
     "fieldConfig": {"defaults": {"custom": {"align": "auto", "filterable": true}}, "overrides": [
       {"matcher": {"id": "byName", "options": "bytes_transferred"},
        "properties": [{"id": "unit", "value": "bytes"}, {"id": "displayName", "value": "Bytes Transferred"}]},
       {"matcher": {"id": "byName", "options": "result_status"},
        "properties": [{"id": "displayName", "value": "Status"},
          {"id": "custom.cellOptions", "value": {"type": "color-text"}},
          {"id": "mappings", "value": [
            {"type": "value", "options": {"SUCCESS": {"color": "green", "index": 0}}},
            {"type": "value", "options": {"OK": {"color": "green", "index": 1}}},
            {"type": "value", "options": {"FAILED": {"color": "red", "index": 2}}},
            {"type": "value", "options": {"RUNNING": {"color": "blue", "index": 3}}},
            {"type": "value", "options": {"QUEUED": {"color": "blue", "index": 4}}}]}]}]},
     "options": {"showHeader": true, "sortBy": [{"displayName": "time", "desc": true}]},
     "transformations": [
       {"id": "organize", "options": {
         "excludeByName": {},
         "indexByName": {"time": 0, "tenant": 1, "server": 2, "category": 3, "result_status": 4, "asset_name": 5, "policy_name": 6, "bytes_transferred": 7},
         "renameByName": {"time": "Time", "tenant": "Tenant", "server": "Server", "category": "Category", "asset_name": "Asset", "policy_name": "Policy"}}}],
     "targets": [{"refId": "A", "format": "table", "rawQuery": true,
       "rawSql": "SELECT created_at AS \"time\", tenant, server, category, result_status, asset_name, policy_name, bytes_transferred FROM backup_jobs WHERE $__timeFilter(created_at) AND tenant IN ($tenant) AND server IN ($server) AND result_status IN ($result_status) ORDER BY created_at DESC LIMIT 1000"}]},
    {"id": 2, "type": "table", "title": "Copies (retention & location)", "datasource": {"type": "postgres", "uid": "backuphistory"},
     "gridPos": {"h": 12, "w": 24, "x": 0, "y": 16},
     "fieldConfig": {"defaults": {"custom": {"align": "auto", "filterable": true}}, "overrides": [
       {"matcher": {"id": "byName", "options": "size_bytes"},
        "properties": [{"id": "unit", "value": "bytes"}, {"id": "displayName", "value": "Size"}]},
       {"matcher": {"id": "byName", "options": "copy_type"},
        "properties": [{"id": "displayName", "value": "Copy Type"},
          {"id": "custom.cellOptions", "value": {"type": "color-text"}},
          {"id": "mappings", "value": [
            {"type": "value", "options": {"FULL": {"color": "green", "index": 0}}},
            {"type": "value", "options": {"SYNTHETIC_FULL": {"color": "blue", "index": 1}}},
            {"type": "value", "options": {"INCREMENTAL": {"color": "blue", "index": 2}}},
            {"type": "value", "options": {"DIFFERENTIAL": {"color": "yellow", "index": 3}}}]}]},
       {"matcher": {"id": "byName", "options": "retention_lock"},
        "properties": [{"id": "displayName", "value": "Retention Lock"},
          {"id": "custom.cellOptions", "value": {"type": "color-text"}},
          {"id": "mappings", "value": [
            {"type": "value", "options": {"true": {"text": "LOCKED", "color": "green", "index": 0}}},
            {"type": "value", "options": {"false": {"text": "unlocked", "color": "yellow", "index": 1}}}]}]}]},
     "options": {"showHeader": true, "sortBy": [{"displayName": "time", "desc": true}]},
     "transformations": [
       {"id": "organize", "options": {
         "excludeByName": {},
         "indexByName": {"time": 0, "tenant": 1, "asset_id": 2, "copy_type": 3, "retention_time": 4, "retention_lock": 5, "location": 6, "size_bytes": 7},
         "renameByName": {"time": "Time", "tenant": "Tenant", "asset_id": "Asset ID", "retention_time": "Retention Time", "location": "Location"}}}],
     "targets": [{"refId": "A", "format": "table", "rawQuery": true,
       "rawSql": "SELECT create_time AS \"time\", tenant, asset_id, copy_type, retention_time, retention_lock, location, size_bytes FROM copies WHERE $__timeFilter(create_time) AND tenant IN ($tenant) ORDER BY create_time DESC LIMIT 1000"}]}
  ]
}

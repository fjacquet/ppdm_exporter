# Copy to .env and fill in — `.env` is gitignored, never commit real secrets.
# Compose reads .env natively, and the ppdm_exporter binary itself loads .env from
# the working directory (or next to config.yaml). Already-set environment variables
# always take precedence over .env values.

# Exporter image tag (GHCR). Pin a release for production instead of :latest.
PPDM_TAG=latest

# Password for the PPDM monitoring user. config.yaml references it as ${PPDM1_PASSWORD}.
# Special characters: wrap the value in single quotes so it is taken literally, e.g.
# PPDM1_PASSWORD='p@$$w0rd!#{}'. Double quotes expand $VAR and process backslashes;
# unquoted values treat " #" (space-hash) as a comment. For a literal ' use double
# quotes ("p'ass"); for a " use single quotes ('p"ass'); for both, a backslash, or a
# value starting with a quote, use passwordFile in config.yaml instead (read verbatim).
PPDM1_PASSWORD=changeme

# Optional: override host and username via environment instead of editing config.yaml.
# Useful for single-server deployments where secrets management sets env vars.
# config.yaml is the source of truth; one entry per server for multi-server setups.
PPDM1_HOSTNAME=ppdm01.example.com
PPDM1_USERNAME=ppdm-monitor

# Skip TLS cert verification for this server (INSECURE — trusted network only).
# config.yaml can reference it as insecureSkipVerify: ${PPDM1_SKIP_CERTIFICATE}
# instead of a literal true/false.
PPDM1_SKIP_CERTIFICATE=false

# Grafana admin login.
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=changeme

# Public URL Grafana is served at (your server, not localhost) — needed so login
# redirects and share links resolve correctly when accessed remotely.
GF_SERVER_ROOT_URL=http://your-server.example.com:3000
